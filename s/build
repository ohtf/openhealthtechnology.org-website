#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Open Health Technology Foundation contributors
# SPDX-License-Identifier: CC-BY-SA-4.0
#
# Build the static site into site/, exactly as CI does.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ -x .venv/bin/zensical ]]; then
  ZENSICAL=.venv/bin/zensical
else
  ZENSICAL=zensical
fi

"$ZENSICAL" build --clean "$@"

# Zensical excludes dot directories; publish these protocol JSON endpoints
# explicitly rather than relying on unsupported MkDocs include_docs settings.
install -d site/.well-known/matrix
for endpoint in client server; do
  python3 -m json.tool "docs/.well-known/matrix/$endpoint" >/dev/null
  install -m 644 "docs/.well-known/matrix/$endpoint" "site/.well-known/matrix/$endpoint"
done
